# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
# No leading slash: medusa/ is a second npm project inside this tree with its own
# node_modules, and a rooted pattern would miss it.
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the two that carry no secrets and exist to be read: they are the only record of
# what a fresh deployment has to be told.
!.env.example
!.env.template

# vercel
.vercel

# medusa backend build output
medusa/.medusa
medusa/dist
medusa/static

# performance harness dumps -- bundle copies written by scripts/, hundreds of megabytes
.qa

# typescript
*.tsbuildinfo
next-env.d.ts

# local Claude Code permission grants -- per-machine, not project configuration
.claude/settings.local.json
