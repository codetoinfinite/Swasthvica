# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgres://localhost:5432/swasthvica_medusa
REDIS_URL=redis://localhost:6379

# "server" serves Store + Admin APIs. "worker" runs subscribers, jobs and workflow steps.
# "shared" runs both in one process -- development only.
MEDUSA_WORKER_MODE=shared

STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:3000,http://localhost:9000

JWT_SECRET=
COOKIE_SECRET=

# --- India GST (see docs/BACKEND-PLAN.md 5.4). Blocked on the client. ---
# The state the business is registered in -- the place of supply. Deliveries to it are taxed
# CGST + SGST, deliveries anywhere else IGST, so this single line decides the heads on every
# invoice. Spell it as the storefront's own address form does, in full and with "and" rather
# than "&": "Uttar Pradesh", "Tamil Nadu", "Jammu and Kashmir". The backend refuses to start on
# a spelling it does not recognise, and refuses to price a cart while this is empty.
GST_ORIGIN_STATE=
#
# Rates are NOT set here. Each product's HSN and GST percentage live in src/data/gst.json, are
# loaded into the database by `npm run seed:gst`, and are the client's to change in the admin
# afterwards (Settings -> Tax Regions).

# --- Razorpay (see docs/BACKEND-PLAN.md 8 and 17.4). Blocked on the client. ---
# Dashboard -> Account & Settings -> API Keys. Test keys (rzp_test_...) take real cards in test
# mode and move no money; live keys (rzp_live_...) need a completed KYC.
#
# Leave RAZORPAY_KEY_ID empty and the provider is not registered at all -- checkout then runs on
# Medusa's built-in `pp_system_default`, which authorises anything and charges nothing, so the
# whole cart-to-order path still works on a laptop. Set it and the secret must be set too, or the
# backend refuses to start rather than failing on a customer's first payment.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
#
# Dashboard -> Settings -> Webhooks. Point the webhook at
#   <public backend URL>/hooks/payment/razorpay_in
# and subscribe to: order.paid, payment.captured, payment.authorized, payment.failed.
# This is what lets an order complete for a customer whose browser closed between paying and
# coming back. Without this secret every webhook is rejected, because an unverifiable one cannot
# be told from a forgery.
RAZORPAY_WEBHOOK_SECRET=

# --- Transactional e-mail (see docs/BACKEND-PLAN.md 15 and 17). Blocked on the client. ---
# resend.com -> API Keys. A key with "Sending access" is all this needs; it is read at boot and
# never written anywhere else.
#
# Leave RESEND_API_KEY empty and the provider is not registered -- Medusa's local provider takes
# the email channel instead and writes each notification to the log, so every subscriber, template
# and idempotency key can be exercised on a laptop without an account. Set it and RESEND_FROM must
# be set too, or the backend refuses to start rather than failing on a customer's confirmation.
RESEND_API_KEY=
#
# The sender. "Swasthvica <orders@swasthvica.com>" is accepted; the domain must be verified at
# resend.com -> Domains (SPF and DKIM), or Resend rejects every send. An unverified domain is the
# single most common cause of mail that "sends" and never arrives.
RESEND_FROM=
#
# Where a customer's reply lands, when that is not the sending address. Optional.
RESEND_REPLY_TO=

# --- Where transactional e-mails link back to. ---
# Every link in a confirmation is built from this, so on a deployed backend it must be the
# storefront's own public origin, with no trailing slash: https://swasthvica.com. It defaults to
# http://localhost:3000 in development and is refused outright when NODE_ENV=production, because
# a confirmation full of localhost links is invisible from the server -- the mail sends, and the
# links are dead for everyone but the person who deployed it.
STOREFRONT_URL=

# --- Object storage (optional). Without S3_BUCKET, uploads go to medusa/static on local disk. ---
S3_BUCKET=
S3_REGION=ap-south-1
S3_FILE_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
